<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Sandra, veebiprogrammeerimine</title>
	<style>
        .news-item {
            margin-bottom: 50px; 
            border-bottom: 1px solid #ddd;
            padding-bottom: 20px;
        }
        .news-item h2 {
            margin-bottom: -8px; 
        }
    </style>
</head>
<body>
	<img src="../Pic/veebiprogrammeerimine_2026_ID.png" alt="">
	<h1>Uudisteportaal</h1>
	<% if (locals.usersName) { %>
    Sisse logitud kasutaja: <%= locals.usersName %>
	<% } %>
	<a href="/logout"><button>Logi välja</button></a>
	<br><br>
	<a href="/home"><button>Esileht</button></a>
	<hr>
	<div class="news-container">
    <% if (newsData && newsData.length > 0) { %>
        <% newsData.forEach(function(uudis) { %>
            <div class="news-item">
                <h2><%= uudis.news_title %></h2>
                <p class="metadata">
                    Lisatud: <%= uudis.created.toLocaleDateString('et-EE') %> <br> Autor: <%= uudis.firstname %> <%= uudis.lastname %>
                </p>
                <% if (uudis.filename) { %>
                    <img src="/gallery/news_normal/<%=uudis.filename%>" alt="<%= uudis.alttext %>">
                <% } %>
                <p><%= uudis.news_text %></p>
            </div>
        <% }); %>
    <% } else { %>
        <p>Ühtegi uudist ei ole!</p>
    <% } %>
</div>
</body>
</html>