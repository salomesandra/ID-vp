<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Sandra, veebiprogrammeerimine</title>
</head>
<body>
	<img src="Pic/veebiprogrammeerimine_2026_ID.png" alt="">
	<h1>Sandra, veebiprogrammeerimine</h1>
	 <p>See leht on loodud veebiprogrammeerimise kursusel <a href="https://www.tlu.ee">Tallinna Ülikoolis</a> ning ei sisalda tõsiseltvõetavat sisu!</p>
	<hr>
	<% if (locals.usersName) { %>
    Sisse logitud kasutaja: <%= locals.usersName %>
	<% } %>
	<a href="/logout"><button>Logi välja</button></a>
	<br><br>
	<a href="/galleryPhotoUpload"><button>Fotode üleslaadimine pildigaleriisse</button></a>
	<a href="/fotogalerii"><button>Üldine fotogalerii</button></a>
	<a href="/privaatgalerii"><button>Privaatne fotogalerii</button></a>
	<a href="/addnews"><button>Lisa uudiseid</button></a>
	<a href="/readnews"><button>Uudisteportaal</button></a>
	
	<br><br>
	<div class="news-container">
    <% if (frontNews) { %>

            <div class="news-item">
                <h2><%= frontNews.news_title %></h2>
                <p class="metadata">
                    Lisatud: <%= frontNews.created %> <br> Autor: <%= frontNews.firstname %> <%= frontNews.lastname %>
                </p>
                <% if (frontNews.filename) { %>
                    <img src="/gallery/news_normal/<%=frontNews.filename%>" alt="<%= frontNews.alttext %>">
					 <% } %>
                <p><%= frontNews.news_text %></p>
            </div>
    <% } else { %>
        <p>Ühtegi uudist ei ole!</p>
    <% } %>
</div>
</body>
</html>