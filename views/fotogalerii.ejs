<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Sandra, veebiprogrammeerimine</title>
    <link rel="stylesheet" href="/style/gallery.css">
	<script src="/script/gallery.js" defer></script>
</head>
<body>
    <img src="../Pic/veebiprogrammeerimine_2026_ID.png" alt="">
    <h1>Fotogalerii</h1>
    <hr>
    <% if (locals.usersName) { %>
    Sisse logitud kasutaja: <%= locals.usersName %>
	<% } %>
	<a href="/logout"><button>Logi välja</button></a>
	<br><br>
	<a href="/home"><button>Esileht</button></a>
	
	<br><br>
	
	<dialog id="modal" class="modalarea">
		<span id="modalClose" class="modalclose">&times;</span>
		<div class="modalhorizontal">
			<div class="modalvertical">
				<p id="modalCaption"></p>
				<img id="modalImage" src="../Pic/empty.png" alt="galeriipilt">
			</div>
		</div>
	</dialog>
	
	<p><%- links %></p>
	
    <div id="gallery" class="gallery">
        <% photoData.forEach(function(image){ %>
            <img src="/gallery/thumbs/<%=image.filename%>" alt="<%=image.alttext%>" loading="lazy" class="thumbs" data-id="<%= image.id %> data-filename="<%= image.src %>">
            <% }); %>
    </div>

    <br><br>
    

</body>
</html>