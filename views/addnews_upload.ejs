<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Sandra, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../Pic/veebiprogrammeerimine_2026_ID.png" alt="">
	<h1>Uudiste lisamine</h1>
	<% if (locals.usersName) { %>
    Sisse logitud kasutaja: <%= locals.usersName %>
	<% } %>
	<a href="/logout"><button>Logi välja</button></a>
	<br><br>
	<a href="/home"><button>Esileht</button></a>
	<hr>
	<form method="POST" enctype="multipart/form-data">
		<label for="titleInput">Uudise pealkiri</label>
		<input type="text" name="titleInput" id="titleInput" placeholder="Uudise pealkiri ..." required>
		<br><br>
		<label for="contentInput">Uudise sisu</label>
		<br>
		<textarea id="contentInput" name="contentInput" placeholder="Uudise sisu ..." required rows="5" cols="80" maxlength="2000"></textarea>
		<br>
		<label for="expireInput">Uudise aegumiskuupäev</label>
		<input type="date" name="expireInput" id="expireInput" required>
		<br><br>
		<label for="photoInput">Lisa uudisele pildifail (jpg)</label>
		<input id="photoInput" name="photoInput" type="file">
		<br><br>
		<label for="altInput">Foto alternatiivtekst (alt)</label>
		<input id="altInput" name="altInput" type="text" placeholder="Sellel fotol on ...">
		<br>
		<input id="privacyInput1" name="privacyInput" type="radio" value="1" checked>
		<label for="privacyInput1">Privaatne (ainult ise näen)</label>
		<br>
		<input id="privacyInput2" name="privacyInput" type="radio" value="2">
		<label for="privacyInput2">Sisseloginud kasutajatele</label>
		<br>
		<input id="privacyInput3" name="privacyInput" type="radio" value="3">
		<label for="privacyInput3">Avalik (kõik näevad)</label>
		<br>
		<input type="submit" name="newsSubmit" value="Salvesta">
	</form>
</body>
</html>